{# Segredos lidos do Parameter Store no momento do deploy, no prefixo do
   ambiente alvo. Nunca residem no repositorio nem em disco no control node. #}
DB_USER={{ lookup('amazon.aws.aws_ssm', '/comments-api/' ~ ambiente ~ '/db_user', region=regiao, decrypt=True) }}
DB_PASSWORD={{ lookup('amazon.aws.aws_ssm', '/comments-api/' ~ ambiente ~ '/db_password', region=regiao, decrypt=True) }}
DB_NAME={{ lookup('amazon.aws.aws_ssm', '/comments-api/' ~ ambiente ~ '/db_name', region=regiao, decrypt=True) }}
GRAFANA_PASSWORD={{ lookup('amazon.aws.aws_ssm', '/comments-api/' ~ ambiente ~ '/grafana_password', region=regiao, decrypt=True) }}
API_IMAGE={{ api_image }}
